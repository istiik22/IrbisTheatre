@{
    ViewData["Title"] = "Покупка билетов";
    var performances = ViewBag.Performances as IEnumerable<IrbisTheatre.Models.Performance>;
    var selectedPerformance = ViewBag.SelectedPerformance as IrbisTheatre.Models.Performance;
    var seats = ViewBag.Seats as IEnumerable<IrbisTheatre.Models.Seat>;
    var bookedSeats = ViewBag.BookedSeats as List<int> ?? new List<int>();
    var selectedPlay = ViewBag.SelectedPlay as IrbisTheatre.Models.Play;
    var performancesForPlay = ViewBag.Performances as IEnumerable<IrbisTheatre.Models.Performance>;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Театр "Irbis"</title>
    <link rel="stylesheet" href="~/css/stars.css">
    <link rel="stylesheet" href="~/css/main.css">
    <style>
        .tickets-container {
            min-height: 100vh;
            padding: 120px 20px 60px;
        }

        .tickets-card {
            background: rgba(26, 26, 74, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(123, 104, 238, 0.5);
            border-radius: 20px;
            padding: 30px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .tickets-title {
            text-align: center;
            font-size: 28px;
            margin-bottom: 30px;
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .performance-select {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(123,104,238,0.3);
            color: white;
            margin-bottom: 20px;
            font-size: 16px;
        }

            .performance-select option {
                background: #1a1a4a;
            }

        .stage {
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            text-align: center;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            font-weight: bold;
        }

        .seats-grid {
            display: grid;
            grid-template-columns: repeat(10, 1fr);
            gap: 8px;
            max-width: 600px;
            margin: 20px auto;
        }

        .seat {
            aspect-ratio: 1;
            background: #2ecc71;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            transition: all 0.3s;
        }

            .seat:hover {
                transform: scale(1.05);
                filter: brightness(1.1);
            }

            .seat.occupied {
                background: #e74c3c;
                cursor: not-allowed;
                opacity: 0.6;
            }

            .seat.selected {
                background: #3498db;
                box-shadow: 0 0 10px #3498db;
            }

        .legend {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
        }

        .customer-form {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group input {
                width: 100%;
                padding: 12px;
                border-radius: 8px;
                background: rgba(255,255,255,0.1);
                border: 1px solid rgba(123,104,238,0.3);
                color: white;
                font-size: 16px;
            }

                .form-group input:focus {
                    outline: none;
                    border-color: #7b68ee;
                }

        .btn-buy {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
        }

            .btn-buy:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(123,104,238,0.5);
            }

        .btn-secondary {
            display: inline-block;
            width: auto;
            padding: 12px 24px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(123,104,238,0.5);
            border-radius: 10px;
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
        }

            .btn-secondary:hover {
                background: rgba(123,104,238,0.3);
            }

        .alert {
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .alert-error {
            background: rgba(231, 76, 60, 0.2);
            border: 1px solid #e74c3c;
            color: #ff6b7c;
        }

        .selected-info {
            text-align: center;
            margin: 15px 0;
            color: #7b68ee;
            font-size: 16px;
        }

        h3 {
            text-align: center;
            margin: 10px 0;
        }

        .performance-info {
            text-align: center;
            color: #aaa;
            margin-bottom: 20px;
        }

        .play-selection-card {
            background: rgba(123,104,238,0.2);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 25px;
            text-align: center;
        }

            .play-selection-card h3 {
                margin-bottom: 15px;
                color: #7b68ee;
            }

        .performances-list {
            margin-top: 15px;
        }

        .performance-option {
            background: rgba(255,255,255,0.05);
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .performance-date {
            font-weight: bold;
        }

        .performance-price {
            color: #2ecc71;
        }

        .select-performance-btn {
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            border: none;
            padding: 8px 20px;
            border-radius: 8px;
            color: white;
            cursor: pointer;
        }

        @@media (max-width: 768px) {
            .seats-grid {
                grid-template-columns: repeat(8, 1fr);
                gap: 5px;
            }

            .seat {
                font-size: 8px;
            }

            .performance-option {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="stars" id="stars"></div>

    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <h1>Театр "Irbis"</h1>
                </div>
                <nav>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")">Главная</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <div class="tickets-container">
        <div class="tickets-card">
            <h1 class="tickets-title">Покупка билетов</h1>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }

            @* Блок когда выбран спектакль, но ещё не выбран показ *@
            @if (selectedPlay != null)
            {
                <div class="play-selection-card">
                    <h3>🎭 @selectedPlay.Title</h3>
                    @if (performancesForPlay != null && performancesForPlay.Any())
                    {
                        <p>Выберите дату показа:</p>
                        <div class="performances-list">
                            @foreach (var perf in performancesForPlay)
                            {
                                <div class="performance-option">
                                    <span class="performance-date">📅 @perf.Datetime.ToString("dd.MM.yyyy HH:mm")</span>
                                    <span class="performance-price">💰 от @perf.BasePrice ₽</span>
                                    <a href="/Tickets/PurchaseByPerformance?performanceId=@perf.Id" class="select-performance-btn">Выбрать этот показ</a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color: #ff4757;">На данный спектакль пока нет доступных показов</p>
                        <a href="/#playbill" class="btn-secondary">Вернуться к афише</a>
                    }
                </div>
            }

            @* Блок выбора спектакля из списка (если пришли без выбранного спектакля) *@
            @if (selectedPlay == null && selectedPerformance == null)
            {
                <form method="get" asp-action="Purchase" asp-controller="Tickets">
                    <select name="playId" class="performance-select" onchange="this.form.submit()">
                        <option value="">-- Выберите спектакль --</option>
                        @if (ViewBag.Plays != null)
                        {
                            foreach (var play in ViewBag.Plays)
                            {
                                <option value="@play.Id">@play.Title</option>
                            }
                        }
                    </select>
                </form>
            }

            @* Блок выбора мест (когда выбран конкретный показ) *@
            @if (selectedPerformance != null)
            {
                <h3>@selectedPerformance.Play?.Title</h3>
                <div class="performance-info">@selectedPerformance.Datetime.ToString("dd.MM.yyyy HH:mm")</div>

                <div class="stage">СЦЕНА</div>

                <div class="legend">
                    <div class="legend-item"><div class="legend-color" style="background:#2ecc71"></div><span>Свободно</span></div>
                    <div class="legend-item"><div class="legend-color" style="background:#e74c3c"></div><span>Занято</span></div>
                    <div class="legend-item"><div class="legend-color" style="background:#3498db"></div><span>Выбрано</span></div>
                </div>

                <div class="seats-grid" id="seatsGrid">
                    @if (seats != null)
                    {
                        foreach (var seat in seats)
                        {
                            var isBooked = bookedSeats.Contains(seat.Id);
                            if (isBooked)
                            {
                                <div class="seat occupied" data-seat-id="@seat.Id" data-row="@seat.RowNumber" data-num="@seat.SeatNumber">
                                    @seat.RowNumber-@seat.SeatNumber
                                </div>
                            }
                            else
                            {
                                <div class="seat" data-seat-id="@seat.Id" data-row="@seat.RowNumber" data-num="@seat.SeatNumber">
                                    @seat.RowNumber-@seat.SeatNumber
                                </div>
                            }
                        }
                    }
                </div>

                <div class="selected-info" id="selectedInfo">Выбрано мест: 0</div>

                <form method="post" asp-action="Purchase" asp-controller="Tickets" id="purchaseForm">
                    <input type="hidden" name="performanceId" value="@selectedPerformance.Id">
                    <input type="hidden" name="selectedSeats" id="selectedSeatsInput">

                    <div class="customer-form">
                        <h3 style="text-align:left">Данные для получения билетов</h3>
                        <div class="form-group">
                            <input type="text" name="customerName" placeholder="Ваше имя" required>
                        </div>
                        <div class="form-group">
                            <input type="email" name="customerEmail" placeholder="Ваш email" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-buy">Купить билеты</button>
                </form>
            }
        </div>
    </div>

    <script src="~/js/main.js"></script>
    <script>
        let selectedSeats = [];

        document.querySelectorAll('.seat:not(.occupied)').forEach(seat => {
            seat.addEventListener('click', function() {
                const seatId = this.getAttribute('data-seat-id');
                if (this.classList.contains('selected')) {
                    this.classList.remove('selected');
                    selectedSeats = selectedSeats.filter(id => id !== seatId);
                } else {
                    this.classList.add('selected');
                    selectedSeats.push(seatId);
                }
                document.getElementById('selectedInfo').innerText = `Выбрано мест: ${selectedSeats.length}`;
                document.getElementById('selectedSeatsInput').value = selectedSeats.join(',');
            });
        });

        const form = document.getElementById('purchaseForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                if (selectedSeats.length === 0) {
                    e.preventDefault();
                    alert('Выберите хотя бы одно место');
                }
            });
        }
    </script>
</body>
</html>