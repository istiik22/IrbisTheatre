@{
    ViewData["Title"] = "Актёрская панель";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <h2>Актёрская панель</h2>
    <p>Ваши роли и расписание</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">🎭</div>
        <h3>Мои роли</h3>
        <p class="stat-value">@(ViewBag.MyRoles?.Count ?? 0)</p>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📅</div>
        <h3>Ближайшие выступления</h3>
        <p class="stat-value">@(ViewBag.MySchedule?.Count ?? 0)</p>
    </div>
</div>

@if (ViewBag.MyRoles != null && ((System.Collections.IEnumerable)ViewBag.MyRoles).Cast<object>().Any())
{
    <div class="roles-section">
        <h3>Мои роли</h3>
        <div class="roles-list">
            @foreach (var pt in ViewBag.MyRoles)
            {
                <div class="role-card">
                    <h4>@pt.Role?.Name</h4>
                    <p><strong>Спектакль:</strong> @pt.Role?.Play?.Title</p>
                    <p><strong>Тип участия:</strong> @pt.ParticipationType</p>
                </div>
            }
        </div>
    </div>
}

@if (ViewBag.MySchedule != null && ((System.Collections.IEnumerable)ViewBag.MySchedule).Cast<object>().Any())
{
    <div class="schedule-section">
        <h3>Моё расписание</h3>
        <div class="schedule-list">
            @foreach (var perf in ViewBag.MySchedule)
            {
                <div class="schedule-item">
                    <span class="date">@perf.Datetime.ToString("dd.MM.yyyy")</span>
                    <span class="time">@perf.Datetime.ToString("HH:mm")</span>
                    <span class="play">@perf.Play?.Title</span>
                    <span class="status">@perf.Status</span>
                </div>
            }
        </div>
    </div>
}

<style>
    .roles-section, .schedule-section {
        margin: 30px 0;
    }

        .roles-section h3, .schedule-section h3 {
            margin-bottom: 20px;
            color: #7b68ee;
        }

    .roles-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
    }

    .role-card {
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 15px;
        border: 1px solid rgba(123,104,238,0.3);
    }

        .role-card h4 {
            color: #7b68ee;
            margin-bottom: 10px;
        }

    .schedule-list {
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        overflow: hidden;
    }

    .schedule-item {
        display: flex;
        gap: 20px;
        padding: 12px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .date {
        min-width: 100px;
        font-weight: bold;
    }

    .time {
        min-width: 60px;
    }

    .play {
        flex: 1;
    }

    .status {
        color: #2ecc71;
    }
</style>