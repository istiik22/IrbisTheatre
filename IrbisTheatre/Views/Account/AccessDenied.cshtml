@{
    ViewData["Title"] = "Доступ запрещён";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Театр "Irbis"</title>
    <link rel="stylesheet" href="~/css/stars.css">
    <link rel="stylesheet" href="~/css/main.css">
    <style>
        .error-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px;
        }

        .error-card {
            text-align: center;
            background: rgba(26, 26, 74, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 71, 87, 0.5);
            border-radius: 20px;
            padding: 50px;
            max-width: 500px;
        }

        .error-icon {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .error-card h1 {
            font-size: 28px;
            margin-bottom: 15px;
            color: #ff4757;
        }

        .error-card p {
            color: #ccc;
            margin-bottom: 30px;
        }

        .btn-home {
            padding: 12px 30px;
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            border: none;
            border-radius: 10px;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

            .btn-home:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(123, 104, 238, 0.5);
            }
    </style>
</head>
<body>
    <div class="stars" id="stars"></div>

    <div class="error-container">
        <div class="error-card">
            <div class="error-icon">⛔</div>
            <h1>Доступ запрещён</h1>
            <p>У вас нет прав для доступа к этой странице.<br>Обратитесь к администратору.</p>
            <a href="@Url.Action("Index", "Home")" class="btn-home">Вернуться на главную</a>
        </div>
    </div>

    <script src="~/js/main.js"></script>
</body>
</html>