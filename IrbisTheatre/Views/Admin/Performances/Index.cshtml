@{
    ViewData["Title"] = "Управление показами";
    Layout = "_DashboardLayout";
    var performances = ViewBag.Performances as List<IrbisTheatre.Models.Performance>;
}

<div class="content-section active" id="dashboard-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div>
            <h2 style="font-size: 28px; margin-bottom: 5px;">📅 Показы</h2>
            <p style="color: #aaa;">Управление расписанием спектаклей</p>
        </div>
        <a href="/Dashboard/CreatePerformance" class="btn-primary" style="text-decoration: none;">➕ Добавить показ</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success" style="background: rgba(46,204,113,0.2); border: 1px solid #2ecc71; border-radius: 10px; padding: 12px; margin-bottom: 20px; color: #6fdf9b;">
            @TempData["Success"]
        </div>
    }

    <div class="card">
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Спектакль</th>
                        <th>Дата и время</th>
                        <th>Базовая цена</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (performances != null && performances.Any())
                    {
                        foreach (var perf in performances)
                        {
                            <tr>
                                <td>@perf.Id</td>
                                <td>@perf.Play?.Title</td>
                                <td>@perf.Datetime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@perf.BasePrice ₽</td>
                                <td>
                                    <span class="status-badge @(perf.Status == "запланирован" ? "status-active" : "status-inactive")">
                                        @perf.Status
                                    </span>
                                </td>
                                <td style="display: flex; gap: 10px;">
                                    <a href="/Dashboard/EditPerformance/@perf.Id" class="btn-edit">✏️</a>
                                    <a href="/Dashboard/DeletePerformance/@perf.Id" class="btn-delete" onclick="return confirm('Удалить показ? Это удалит все связанные билеты!')">🗑️</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center;">Нет показов</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-edit, .btn-delete {
        padding: 5px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 14px;
    }

    .btn-edit {
        background: rgba(52, 152, 219, 0.2);
        color: #3498db;
    }

    .btn-delete {
        background: rgba(231, 76, 60, 0.2);
        color: #e74c3c;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .status-active {
        background: rgba(46,204,113,0.2);
        color: #2ecc71;
    }

    .status-inactive {
        background: rgba(231,76,60,0.2);
        color: #e74c3c;
    }
</style>