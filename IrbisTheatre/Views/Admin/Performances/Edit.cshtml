@{
    ViewData["Title"] = "Редактировать показ";
    Layout = "_DashboardLayout";
    var currentPerformance = ViewBag.Performance as IrbisTheatre.Models.Performance;
}

<div class="content-section active" id="dashboard-section">
    <div style="margin-bottom: 25px;">
        <h2 style="font-size: 28px; margin-bottom: 5px;">✏️ Редактировать показ</h2>
        <p style="color: #aaa;">Измените информацию о показе</p>
    </div>

    <div class="card">
        <form method="post" action="/Admin/Performances/Edit">
            <input type="hidden" name="Id" value="@currentPerformance?.Id">
            <div class="form-row">
                <div class="form-group">
                    <label>Спектакль *</label>
                    <select name="PlayId" class="form-control" required>
                        <option value="">Выберите спектакль</option>
                        @if (ViewBag.Plays != null)
                        {
                            foreach (var play in ViewBag.Plays)
                            {
                                if (currentPerformance?.PlayId == play.Id)
                                {
                                    <option value="@play.Id" selected>@play.Title</option>
                                }
                                else
                                {
                                    <option value="@play.Id">@play.Title</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Дата и время *</label>
                    <input type="datetime-local" name="Datetime" class="form-control" value="@(currentPerformance?.Datetime.ToString("yyyy-MM-ddTHH:mm"))" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Базовая цена (₽) *</label>
                    <input type="number" name="BasePrice" class="form-control" step="100" value="@currentPerformance?.BasePrice" required>
                </div>
                <div class="form-group">
                    <label>Статус</label>
                    <select name="Status" class="form-control">
                        <option value="запланирован" selected="@(currentPerformance?.Status == "запланирован")">Запланирован</option>
                        <option value="отменён" selected="@(currentPerformance?.Status == "отменён")">Отменён</option>
                    </select>
                </div>
            </div>
            <div style="display: flex; gap: 15px; margin-top: 20px;">
                <button type="submit" class="btn-primary">💾 Сохранить</button>
                <a href="/Admin/Performances" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<style>
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
    }

    .form-control {
        width: 100%;
        padding: 10px 15px;
        border-radius: 8px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(123,104,238,0.3);
        color: white;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(123,104,238,0.5);
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>