@{
    ViewData["Title"] = "Редактировать спектакль";
    Layout = "_DashboardLayout";
    var currentPlay = ViewBag.Play as IrbisTheatre.Models.Play;
}

<div class="content-section active" id="dashboard-section">
    <div style="margin-bottom: 25px;">
        <h2 style="font-size: 28px; margin-bottom: 5px;">✏️ Редактировать спектакль</h2>
        <p style="color: #aaa;">Измените информацию о спектакле</p>
    </div>

    <div class="card">
        <form method="post" action="/Admin/Plays/Edit">
            <input type="hidden" name="Id" value="@currentPlay?.Id">
            <div class="form-row">
                <div class="form-group">
                    <label>Название *</label>
                    <input type="text" name="Title" class="form-control" value="@currentPlay?.Title" required>
                </div>
                <div class="form-group">
                    <label>Автор *</label>
                    <select name="AuthorId" class="form-control" required>
                        <option value="">Выберите автора</option>
                        @if (ViewBag.Authors != null)
                        {
                            foreach (var author in ViewBag.Authors)
                            {
                                if (currentPlay?.AuthorId == author.Id)
                                {
                                    <option value="@author.Id" selected>@author.Fio</option>
                                }
                                else
                                {
                                    <option value="@author.Id">@author.Fio</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Жанр *</label>
                    <select name="GenreId" class="form-control" required>
                        <option value="">Выберите жанр</option>
                        @if (ViewBag.Genres != null)
                        {
                            foreach (var genre in ViewBag.Genres)
                            {
                                if (currentPlay?.GenreId == genre.Id)
                                {
                                    <option value="@genre.Id" selected>@genre.Name</option>
                                }
                                else
                                {
                                    <option value="@genre.Id">@genre.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Целевая аудитория</label>
                    <input type="text" name="TargetAudience" class="form-control" value="@currentPlay?.TargetAudience">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Дата премьеры</label>
                    <input type="date" name="PremiereDate" class="form-control" value="@(currentPlay?.PremiereDate?.ToString("yyyy-MM-dd"))">
                </div>
            </div>
            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" class="form-control" rows="5">@currentPlay?.Description</textarea>
            </div>
            <div style="display: flex; gap: 15px; margin-top: 20px;">
                <button type="submit" class="btn-primary">💾 Сохранить</button>
                <a href="/Admin/Plays" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<style>
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
    }

    .form-control {
        width: 100%;
        padding: 10px 15px;
        border-radius: 8px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(123,104,238,0.3);
        color: white;
    }

    textarea.form-control {
        resize: vertical;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(123,104,238,0.5);
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>