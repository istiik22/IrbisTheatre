@{
    ViewData["Title"] = "Удалить спектакль";
    Layout = "_DashboardLayout";
    var play = ViewBag.Play as IrbisTheatre.Models.Play;
}

<div class="content-section active" id="dashboard-section">
    <div class="card" style="max-width: 500px; margin: 0 auto; text-align: center;">
        <div style="font-size: 64px; margin-bottom: 20px;">⚠️</div>
        <h2 style="margin-bottom: 15px;">Удаление спектакля</h2>
        <p>Вы уверены, что хотите удалить спектакль <strong>@play?.Title</strong>?</p>
        <p style="color: #ff4757; font-size: 14px;">Это действие удалит все связанные показы и билеты!</p>

        <form method="post" action="/Admin/Plays/Delete" style="margin-top: 25px;">
            <input type="hidden" name="id" value="@play?.Id">
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button type="submit" class="btn-danger">🗑️ Удалить</button>
                <a href="/Admin/Plays" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<style>
    .btn-danger {
        padding: 10px 24px;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        border-radius: 8px;
        color: white;
        cursor: pointer;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(123,104,238,0.5);
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }
</style>