@{
    ViewData["Title"] = "Управление сотрудниками";
    Layout = "_DashboardLayout";
    var employees = ViewBag.Employees as List<IrbisTheatre.Models.Employer>;
}

<div class="content-section active" id="dashboard-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div>
            <h2 style="font-size: 28px; margin-bottom: 5px;">👥 Сотрудники</h2>
            <p style="color: #aaa;">Управление персоналом театра</p>
        </div>
        <a href="/Dashboard/CreateEmployee" class="btn-primary" style="text-decoration: none;">➕ Добавить сотрудника</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success" style="background: rgba(46,204,113,0.2); border: 1px solid #2ecc71; border-radius: 10px; padding: 12px; margin-bottom: 20px; color: #6fdf9b;">
            @TempData["Success"]
        </div>
    }

    <div class="card">
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ФИО</th>
                        <th>Email</th>
                        <th>Телефон</th>
                        <th>Должность</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (employees != null && employees.Any())
                    {
                        foreach (var emp in employees)
                        {
                            <tr>
                                <td>@emp.Id</td>
                                <td>@emp.Fio</td>
                                <td>@emp.Email</td>
                                <td>@emp.Contacts</td>
                                <td>@emp.Position</td>
                                <td>
                                    <span class="status-badge @(emp.Status == "работает" ? "status-active" : "status-inactive")">
                                        @emp.Status
                                    </span>
                                </td>
                                <td style="display: flex; gap: 10px;">
                                    <a href="/Dashboard/EditEmployee/@emp.Id" class="btn-edit">✏️</a>
                                    <a href="/Dashboard/DeleteEmployee/@emp.Id" class="btn-delete" onclick="return confirm('Удалить сотрудника?')">🗑️</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" style="text-align: center;">Нет сотрудников</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-edit, .btn-delete {
        padding: 5px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 14px;
    }

    .btn-edit {
        background: rgba(52, 152, 219, 0.2);
        color: #3498db;
    }

    .btn-delete {
        background: rgba(231, 76, 60, 0.2);
        color: #e74c3c;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .status-active {
        background: rgba(46,204,113,0.2);
        color: #2ecc71;
    }

    .status-inactive {
        background: rgba(231,76,60,0.2);
        color: #e74c3c;
    }
</style>