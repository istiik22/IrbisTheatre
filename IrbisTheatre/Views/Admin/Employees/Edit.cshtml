@{
    ViewData["Title"] = "Редактировать сотрудника";
    Layout = "_DashboardLayout";
    var emp = ViewBag.Employee as IrbisTheatre.Models.Employer;
}

<div class="content-section active" id="dashboard-section">
    <div style="margin-bottom: 25px;">
        <h2 style="font-size: 28px; margin-bottom: 5px;">✏️ Редактировать сотрудника</h2>
        <p style="color: #aaa;">Измените информацию о сотруднике</p>
    </div>

    <div class="card">
        <form method="post" action="/Dashboard/EditEmployee">
            <input type="hidden" name="Id" value="@emp?.Id">
            <div class="form-row">
                <div class="form-group">
                    <label>ФИО *</label>
                    <input type="text" name="Fio" class="form-control" value="@emp?.Fio" required>
                </div>
                <div class="form-group">
                    <label>Email *</label>
                    <input type="email" name="Email" class="form-control" value="@emp?.Email" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Телефон</label>
                    <input type="text" name="Contacts" class="form-control" value="@emp?.Contacts">
                </div>
                <div class="form-group">
                    <label>Должность *</label>
                    <select name="Position" class="form-control" required>
                        <option value="Администратор" selected="@(emp?.Position == "Администратор")">Администратор</option>
                        <option value="Режиссёр" selected="@(emp?.Position == "Режиссёр")">Режиссёр</option>
                        <option value="Актёр" selected="@(emp?.Position == "Актёр")">Актёр</option>
                        <option value="Музыкант" selected="@(emp?.Position == "Музыкант")">Музыкант</option>
                        <option value="Кассир" selected="@(emp?.Position == "Кассир")">Кассир</option>
                        <option value="Служащий" selected="@(emp?.Position == "Служащий")">Служащий</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Дата рождения</label>
                    <input type="date" name="BirthDate" class="form-control" value="@(emp?.BirthDate?.ToString("yyyy-MM-dd"))">
                </div>
                <div class="form-group">
                    <label>Пол</label>
                    <select name="Gender" class="form-control">
                        <option value="male" selected="@(emp?.Gender == "male")">Мужской</option>
                        <option value="female" selected="@(emp?.Gender == "female")">Женский</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Зарплата</label>
                    <input type="number" name="Salary" class="form-control" step="1000" value="@emp?.Salary">
                </div>
                <div class="form-group">
                    <label>Статус</label>
                    <select name="Status" class="form-control">
                        <option value="работает" selected="@(emp?.Status == "работает")">Работает</option>
                        <option value="уволен" selected="@(emp?.Status == "уволен")">Уволен</option>
                    </select>
                </div>
            </div>
            <div style="display: flex; gap: 15px; margin-top: 20px;">
                <button type="submit" class="btn-primary">💾 Сохранить</button>
                <a href="/Dashboard/Employees" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<style>
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
    }

    .form-control {
        width: 100%;
        padding: 10px 15px;
        border-radius: 8px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(123,104,238,0.3);
        color: white;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(123,104,238,0.5);
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>