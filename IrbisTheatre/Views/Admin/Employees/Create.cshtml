@{
    ViewData["Title"] = "Добавить сотрудника";
    Layout = "_DashboardLayout";
}

<div class="content-section active" id="dashboard-section">
    <div style="margin-bottom: 25px;">
        <h2 style="font-size: 28px; margin-bottom: 5px;">➕ Добавить сотрудника</h2>
        <p style="color: #aaa;">Заполните информацию о новом сотруднике</p>
    </div>

    <div class="card">
        <form method="post" action="/Dashboard/CreateEmployee">
            <div class="form-row">
                <div class="form-group">
                    <label>ФИО *</label>
                    <input type="text" name="Fio" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Email *</label>
                    <input type="email" name="Email" class="form-control" required placeholder="example@irbis-theatre.ru">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Телефон</label>
                    <input type="text" name="Contacts" class="form-control" placeholder="+7 (999) 123-45-67">
                </div>
                <div class="form-group">
                    <label>Должность *</label>
                    <select name="Position" class="form-control" required>
                        <option value="">Выберите должность</option>
                        <option value="Администратор">Администратор</option>
                        <option value="Режиссёр">Режиссёр</option>
                        <option value="Актёр">Актёр</option>
                        <option value="Музыкант">Музыкант</option>
                        <option value="Кассир">Кассир</option>
                        <option value="Служащий">Служащий</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Дата рождения</label>
                    <input type="date" name="BirthDate" class="form-control">
                </div>
                <div class="form-group">
                    <label>Пол</label>
                    <select name="Gender" class="form-control">
                        <option value="">Не указан</option>
                        <option value="male">Мужской</option>
                        <option value="female">Женский</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Зарплата</label>
                    <input type="number" name="Salary" class="form-control" step="1000">
                </div>
                <div class="form-group">
                    <label>Пароль</label>
                    <input type="password" name="Password" class="form-control" value="password123">
                </div>
            </div>
            <div style="display: flex; gap: 15px; margin-top: 20px;">
                <button type="submit" class="btn-primary">💾 Сохранить</button>
                <a href="/Dashboard/Employees" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<style>
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
    }

    .form-control {
        width: 100%;
        padding: 10px 15px;
        border-radius: 8px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(123,104,238,0.3);
        color: white;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(123,104,238,0.5);
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>