@{
    ViewData["Title"] = "Статистика и аналитика";
    Layout = "_DashboardLayout";

    var ticketsByDay = ViewBag.TicketsByDay as IEnumerable<dynamic> ?? new List<dynamic>();
    var revenueByMonth = ViewBag.RevenueByMonth as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="content-section active" id="dashboard-section">
    <div style="margin-bottom: 30px;">
        <h2 style="font-size: 28px; margin-bottom: 8px;">📊 Статистика и аналитика</h2>
        <p style="color: #aaa;">Реальная информация о работе театра на основе данных из системы</p>
    </div>

    <!-- Общая статистика -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🎫</div>
            <h4>Всего продано билетов</h4>
            <div class="stat-value">@ViewBag.TotalTicketsSold</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <h4>Общая выручка</h4>
            <div class="stat-value">@ViewBag.TotalRevenue.ToString("N0") ₽</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🎭</div>
            <h4>Спектаклей в репертуаре</h4>
            <div class="stat-value">@ViewBag.TotalPlays</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <h4>Сотрудников</h4>
            <div class="stat-value">@ViewBag.TotalEmployees</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💺</div>
            <h4>Загрузка залов</h4>
            <div class="stat-value">@ViewBag.HallOccupancy %</div>
        </div>
    </div>

    <!-- Популярное -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
        @if (ViewBag.TopPlay != null)
        {
            <div class="card" style="background: linear-gradient(135deg, rgba(123,104,238,0.2), rgba(74,144,226,0.2));">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="font-size: 48px;">🏆</div>
                    <div>
                        <h4 style="color: #aaa; margin-bottom: 5px;">Самый популярный спектакль</h4>
                        <div style="font-size: 24px; font-weight: bold; color: #7b68ee;">@ViewBag.TopPlay.PlayTitle</div>
                        <p style="color: #aaa;">Продано билетов: @ViewBag.TopPlay.TicketsSold шт.</p>
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.TopHall != null)
        {
            <div class="card" style="background: linear-gradient(135deg, rgba(46,204,113,0.2), rgba(52,152,219,0.2));">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="font-size: 48px;">🏛️</div>
                    <div>
                        <h4 style="color: #aaa; margin-bottom: 5px;">Самый популярный зал</h4>
                        <div style="font-size: 24px; font-weight: bold; color: #2ecc71;">@ViewBag.TopHall.HallName</div>
                        <p style="color: #aaa;">Продано билетов: @ViewBag.TopHall.TicketsSold шт.</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Продажи по дням -->
    <div class="card" style="margin-bottom: 30px;">
        <h3 class="card-title">📈 Продажи за последние 7 дней</h3>
        @if (ticketsByDay != null && ticketsByDay.Any())
        {
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Продано билетов</th>
                            <th>Выручка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in ticketsByDay)
                        {
                            <tr>
                                <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                <td>@day.Count</td>
                                <td>@day.Revenue.ToString("N0") ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="text-align: center; padding: 30px; color: #aaa;">Нет данных о продажах</p>
        }
    </div>

    <!-- Доход по месяцам -->
    <div class="card">
        <h3 class="card-title">💰 Доход по месяцам</h3>
        @if (revenueByMonth != null && revenueByMonth.Any())
        {
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Период</th>
                            <th>Доход</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in revenueByMonth)
                        {
                            <tr>
                                <td>@month.Month.@month.Year</td>
                                <td>@month.Revenue.ToString("N0") ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="text-align: center; padding: 30px; color: #aaa;">Нет данных о доходах</p>
        }
    </div>
</div>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(123,104,238,0.3);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: rgba(123,104,238,0.6);
        }

    .stat-icon {
        font-size: 32px;
        margin-bottom: 10px;
    }

    .stat-card h4 {
        font-size: 13px;
        color: #aaa;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: #7b68ee;
    }

    .card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(123,104,238,0.2);
        border-radius: 16px;
        padding: 24px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 20px;
        color: #7b68ee;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th,
        .data-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .data-table th {
            color: #7b68ee;
            font-weight: 600;
        }
</style>