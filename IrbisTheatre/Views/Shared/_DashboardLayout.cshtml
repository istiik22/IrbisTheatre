@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff";
    var userName = User.Identity?.Name ?? "Сотрудник";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Театр "Irbis"</title>
    <link rel="stylesheet" href="~/css/stars.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0a0a2a 0%, #1a1a4a 50%, #0a0a2a 100%);
            min-height: 100vh;
            color: #fff;
        }

        .dashboard-header {
            background: rgba(10, 10, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(123, 104, 238, 0.3);
            padding: 12px 30px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            font-size: 28px;
            color: #7b68ee;
        }

        .logo-area h1 {
            font-size: 22px;
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-info-header {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(123, 104, 238, 0.15);
            padding: 6px 16px;
            border-radius: 30px;
        }

        .user-avatar-small {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }

        .user-name-header {
            font-size: 14px;
            font-weight: 500;
        }

        .user-role-header {
            font-size: 12px;
            color: #7b68ee;
        }

        .logout-header-btn {
            background: transparent;
            border: 1px solid rgba(255, 71, 87, 0.5);
            color: #ff6b7c;
            padding: 8px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .logout-header-btn:hover {
                background: rgba(255, 71, 87, 0.15);
                border-color: #ff4757;
            }

        .dashboard-wrapper {
            display: flex;
            margin-top: 65px;
            min-height: calc(100vh - 65px);
        }

        .sidebar {
            width: 260px;
            background: rgba(10, 10, 42, 0.9);
            backdrop-filter: blur(10px);
            border-right: 1px solid rgba(123, 104, 238, 0.2);
            padding: 30px 0;
            position: fixed;
            height: calc(100vh - 65px);
            overflow-y: auto;
        }

        .sidebar-nav ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0;
        }

        .sidebar-nav li {
            width: 100%;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 24px;
            color: #ccc;
            text-decoration: none;
            transition: all 0.3s;
            border-left: 3px solid transparent;
        }

            .sidebar-nav a:hover {
                background: rgba(123, 104, 238, 0.1);
                color: white;
                border-left-color: #7b68ee;
            }

            .sidebar-nav a.active {
                background: rgba(123, 104, 238, 0.15);
                color: white;
                border-left-color: #7b68ee;
            }

        .nav-icon {
            font-size: 20px;
            width: 24px;
        }

        .main-content {
            flex: 1;
            margin-left: 260px;
            padding: 30px;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(123, 104, 238, 0.2);
            border-radius: 16px;
            padding: 24px;
            transition: all 0.3s;
        }

            .card:hover {
                border-color: rgba(123, 104, 238, 0.5);
            }

        .card-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #7b68ee;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(123, 104, 238, 0.2);
            border-radius: 16px;
            padding: 20px;
        }

            .stat-card h4 {
                font-size: 14px;
                color: #aaa;
                margin-bottom: 8px;
            }

        .stat-value {
            font-size: 32px;
            font-weight: bold;
            color: #7b68ee;
        }

        .actions-grid {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(123, 104, 238, 0.3);
            border-radius: 12px;
            padding: 12px 20px;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
        }

            .action-btn:hover {
                background: rgba(123, 104, 238, 0.15);
                transform: translateY(-2px);
            }

        .btn-primary {
            background: linear-gradient(135deg, #4a90e2, #7b68ee);
            border: none;
            padding: 10px 24px;
            border-radius: 25px;
            color: white;
            font-weight: 500;
            cursor: pointer;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table th, .data-table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .data-table th {
                color: #7b68ee;
                font-weight: 600;
            }

        .content-section {
            display: none;
            animation: fadeIn 0.3s ease;
        }

            .content-section.active {
                display: block;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 70px;
            }

            .sidebar-nav .nav-text {
                display: none;
            }

            .main-content {
                margin-left: 70px;
            }

            .user-details {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="stars" id="stars"></div>

    <header class="dashboard-header">
        <div class="logo-area">
            <div class="logo-icon">♛</div>
            <h1>Театр "Irbis"</h1>
        </div>
        <div class="header-right">
            <div class="user-info-header">
                <div class="user-avatar-small">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "?")</div>
                <div class="user-details">
                    <div class="user-name-header">@userName</div>
                    <div class="user-role-header">@GetRoleDisplay(role)</div>
                </div>
            </div>
            <button class="logout-header-btn" onclick="window.location.href='/Account/Logout'">Выйти</button>
        </div>
    </header>

    <div class="dashboard-wrapper">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <ul style="display: block; list-style: none; padding: 0;">
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Admin" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">📊</span><span class="nav-text">Обзор</span></a></li>
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Employees" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">👥</span><span class="nav-text">Сотрудники</span></a></li>
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Plays" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">🎭</span><span class="nav-text">Спектакли</span></a></li>
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Performances" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">📅</span><span class="nav-text">Показы</span></a></li>
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Tickets" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">🎫</span><span class="nav-text">Билеты</span></a></li>
                    <li style="display: block; width: 100%;"><a href="/Dashboard/Statistics" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">📊</span><span class="nav-text">Статистика</span></a></li>
                    <li style="display: block; width: 100%;"><a href="#profile" data-section="profile" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">👤</span><span class="nav-text">Профиль</span></a></li>
                    <li><a href="/Dashboard/Schedule"><span class="nav-icon">📅</span><span class="nav-text">Расписание</span></a></li>
                    <li style="display: block; width: 100%;"><a href="#settings" data-section="settings" style="display: flex; align-items: center; gap: 14px; padding: 12px 24px; color: #ccc; text-decoration: none;"><span class="nav-icon">⚙️</span><span class="nav-text">Настройки</span></a></li>
                    
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/dashboard.js"></script>
    <script>
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                if (this.getAttribute('href') && this.getAttribute('href').startsWith('#')) {
                    e.preventDefault();
                    document.querySelectorAll('.sidebar-nav a').forEach(l => l.classList.remove('active'));
                    this.classList.add('active');

                    const section = this.dataset.section;
                    if (section) {
                        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
                        const targetSection = document.getElementById(section + '-section');
                        if (targetSection) targetSection.classList.add('active');
                    }
                }
            });
        });

        function createStars() {
            const container = document.getElementById('stars');
            if (!container) return;
            container.innerHTML = '';
            for (let i = 0; i < 150; i++) {
                const star = document.createElement('div');
                star.classList.add('star');
                star.style.width = Math.random() * 3 + 'px';
                star.style.height = star.style.width;
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.animationDelay = Math.random() * 5 + 's';
                container.appendChild(star);
            }
        }
        createStars();
    </script>
</body>
</html>

@functions {
    string GetRoleDisplay(string role)
    {
        return role switch
        {
            "Admin" => "Администратор",
            "Director" => "Директор",
            "Cashier" => "Кассир",
            "Actor" => "Актёр",
            "Musician" => "Музыкант",
            _ => "Сотрудник"
        };
    }
}